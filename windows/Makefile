LUA_VERSION=lua-5.4.8

all: $(LUA_VERSION)/src/lua.exe cluttex.exe

$(LUA_VERSION).tar.gz:
	wget -O $@ https://www.lua.org/ftp/$(LUA_VERSION).tar.gz
	echo "4f18ddae154e793e46eeab727c59ef1c0c0c2b744e7b94219710d76f530629ae  $(LUA_VERSION).tar.gz" | shasum -a 256 -c -
# TODO: check for sha1sum

$(LUA_VERSION)/src/Makefile: $(LUA_VERSION).tar.gz
	tar xf $<

# linit.c from stock Lua is not used
LIB_EXTRA_O= \
  luafilesystem/src/lfs.o \
  md5/src/md5.o md5/src/md5lib.o md5lib-luapart.o \
  loslibext.o \
  isatty/lua-isatty.o \
  custominit.o

LIB_O=lauxlib.o lbaselib.o lcorolib.o ldblib.o liolib.o \
  lmathlib.o loslib.o lstrlib.o ltablib.o lutf8lib.o loadlib.o \
  $(addprefix ../../,$(LIB_EXTRA_O))

$(LUA_VERSION)/src/liblua.a: $(LUA_VERSION)/src/Makefile md5lib-luapart.c custominit.c u8crt/libu8crt.a
	cd $(LUA_VERSION)/src && $(MAKE) "LUA_A=liblua.a" "LUA_T=lua.exe" \
	"SYSCFLAGS=-DLUA_USER_H=\\\"u8override.h\\\" -I. -I../.. " "SYSLIBS=-L../../u8crt -lu8crt" "SYSLDFLAGS=-s -municode" \
	"LIB_O=$(LIB_O)" \
	liblua.a

$(LUA_VERSION)/src/lua.exe: $(LUA_VERSION)/src/Makefile md5lib-luapart.c custominit.c u8crt/libu8crt.a
	cd $(LUA_VERSION)/src && $(MAKE) "LUA_A=liblua.a" "LUA_T=lua.exe" \
	"SYSCFLAGS=-DLUA_USER_H=\\\"u8override.h\\\" -I. -I../.." "SYSLIBS=-L../../u8crt -lu8crt" "SYSLDFLAGS=-s -municode" \
	"LIB_O=$(LIB_O)" \
	lua.exe

cluttex-luapart.c: embed-cluttex.lua
	lua embed-cluttex.lua
# Other dependecies for cluttex-luapart.c are listed in cluttex-luapart-deps.mk

cluttex.exe: $(LUA_VERSION)/src/liblua.a cluttex-main.o cluttex-luapart.o u8crt/libu8crt.a
	$(CC) -o $@ -municode cluttex-main.o cluttex-luapart.o -L$(LUA_VERSION)/src -llua -Lu8crt -lu8crt

u8crt/libu8crt.a:
	cd u8crt/ && $(MAKE) libu8crt.a

md5lib-luapart.c: md5/src/md5.lua embedlua.lua
	cd md5/src && lua ../../embedlua.lua md5.lua ../../$@

clean:
	-rm $(LIB_EXTRA_O)
	cd $(LUA_VERSION)/src && $(MAKE) clean
	cd u8crt/ && $(MAKE) clean

.PHONY: all clean $(LUA_VERSION)/src/lua.exe u8crt/libu8crt.a

-include cluttex-luapart-deps.mk
# cluttex-luapart-deps.mk is generated by embed-cluttex.lua
